
// Wave 3: dynamic behavior, transfer curves, random active sets, and WAV renders.

const w3Arg=process.argv.find(x=>x.startsWith('--wave3-study='));
const w3Study=w3Arg?w3Arg.slice('--wave3-study='.length):null;
const w3OutArg=process.argv.find(x=>x.startsWith('--out='));
const w3OutDir=path.resolve(w3OutArg?w3OutArg.slice(6):'results-wave3');
fs.mkdirSync(w3OutDir,{recursive:true});

function w3Write(name,payload){
  const obj={
    schema:'sho-kashira-wave3-v1',
    study:name,
    source_commit:SOURCE_COMMIT,
    compute_repo_commit:process.env.GITHUB_SHA||null,
    run_id:process.env.GITHUB_RUN_ID||null,
    sample_rate_hz:sampleRate,
    pressure_tau_s:process.env.SHO_PRESSURE_TAU?Number(process.env.SHO_PRESSURE_TAU):0.060,
    generated_at:new Date().toISOString(),
    payload
  };
  fs.writeFileSync(path.join(w3OutDir,'study.json'),JSON.stringify(obj,null,2)+'\n');
  process.stdout.write(JSON.stringify({
    study:name,sample_rate_hz:sampleRate,
    summary:Array.isArray(payload)?payload.slice(0,10):payload
  },null,2)+'\n');
}

function w3Rms(a){
  let s=0;
  for(const x of a)s+=x*x;
  return Math.sqrt(s/Math.max(1,a.length));
}

function runRingdownScenario({label,pressure,direction}){
  const note=NOTE_DEFS.find(n=>n.name==='一');
  const pipe=new ShoPipeModel(note);
  pipe.gateTarget=1;
  const exciteSamples=Math.floor(sampleRate*2.0);
  for(let i=0;i<exciteSamples;i++) pipe.renderOne(direction*pressure,baseParams);
  const binMs=10;
  const binSamples=Math.max(1,Math.floor(sampleRate*binMs/1000));
  const totalBins=500;
  const envelope=[];
  for(let b=0;b<totalBins;b++){
    const values=[];
    for(let i=0;i<binSamples;i++) values.push(pipe.renderOne(0,baseParams)*0.00062);
    envelope.push({time_ms:(b+1)*binMs,rms:w3Rms(values)});
  }
  let stableBelowMs=null;
  for(let i=0;i<envelope.length;i++){
    if(envelope[i].rms>1e-5) continue;
    let stable=true;
    for(let j=i;j<envelope.length;j++){if(envelope[j].rms>1e-5){stable=false;break;}}
    if(stable){stableBelowMs=envelope[i].time_ms;break;}
  }
  return {label,excite_pressure_pa:pressure,direction:direction>0?'blow':'draw',stable_below_1e5_ms:stableBelowMs,envelope};
}

function runRingdownStudy(){
  return [
    runRingdownScenario({label:'blow_threshold',pressure:370,direction:1}),
    runRingdownScenario({label:'blow_high',pressure:600,direction:1}),
    runRingdownScenario({label:'draw_threshold',pressure:90,direction:-1}),
    runRingdownScenario({label:'draw_high',pressure:600,direction:-1})
  ];
}

function runTransferCurve(){
  const rows=[];
  const pressures=[];
  for(let p=0;p<=800;p+=50)pressures.push(p);
  for(const names of [['一'],CHORD]){
    const group=names.length===1?'single':'chord';
    for(const direction of [1,-1]){
      for(const pressure of pressures){
        const x=runCase({
          names,pressure,direction,shared:true,volumeMl:400,recoveryMs:0.5,
          duration:1.5,flowScope:'all_pipes'
        });
        rows.push({
          group,active_count:names.length,direction:direction>0?'blow':'draw',
          mouth_pressure_pa:pressure,
          mean_abs_kashira_pa:x.mean_abs_kashira_pa,
          pressure_ratio:x.pressure_ratio,
          kashira_pressure_std_pa:x.kashira_pressure_std_pa,
          total_flow_rms_m3_s:x.total_flow_rms_m3_s,
          all_pipes_oscillating:x.all_pipes_oscillating,
          pipe_metrics:x.pipe_metrics
        });
      }
    }
  }
  return rows;
}

function lcg(seed){
  let s=seed>>>0;
  return ()=>{s=(1664525*s+1013904223)>>>0;return s/4294967296;};
}

function runRandomChordStudy(){
  const rnd=lcg(0x53484f32);
  const namesAll=NOTE_DEFS.map(n=>n.name);
  const sets=[];
  const seen=new Set();
  for(let k=0;k<24;k++){
    const count=2+(k%9);
    const shuffled=[...namesAll].sort(()=>rnd()-0.5);
    const names=shuffled.slice(0,count).sort((a,b)=>namesAll.indexOf(a)-namesAll.indexOf(b));
    const key=names.join('|');
    if(seen.has(key)){k--;continue;}
    seen.add(key);
    sets.push({id:k+1,names});
  }
  const rows=[];
  for(const set of sets){
    for(const direction of [1,-1]){
      process.stderr.write(`random set ${set.id} n=${set.names.length} dir=${direction}\n`);
      const x=runAtKashiraTarget({
        names:set.names,targetKashiraPa:600,direction,
        volumeMl:400,recoveryMs:0.5,flowScope:'all_pipes',duration:2.0
      });
      rows.push({
        set_id:set.id,names:set.names,active_count:set.names.length,
        direction:direction>0?'blow':'draw',
        required_mouth_pressure_pa:x.required_mouth_pressure_pa,
        target_error_pa:x.target_error_pa,
        pressure_ratio:x.pressure_ratio,
        kashira_pressure_std_pa:x.kashira_pressure_std_pa,
        total_flow_rms_m3_s:x.total_flow_rms_m3_s,
        all_pipes_oscillating:x.all_pipes_oscillating,
        pipe_metrics:x.pipe_metrics
      });
    }
  }
  return rows;
}

function runMouthAttackProbe(){
  const scenarios=[
    {name:'single_blow',names:['一'],pressure:381,direction:1},
    {name:'single_draw',names:['一'],pressure:96,direction:-1},
    {name:'chord_blow',names:CHORD,pressure:620,direction:1},
    {name:'chord_draw',names:CHORD,pressure:676,direction:-1}
  ];
  return scenarios.map(s=>{
    const x=runCase({
      names:s.names,pressure:s.pressure,direction:s.direction,shared:true,
      volumeMl:400,recoveryMs:0.5,duration:2.5,flowScope:'all_pipes'
    });
    return {
      scenario:s.name,mouth_pressure_pa:s.pressure,
      mean_abs_kashira_pa:x.mean_abs_kashira_pa,
      pressure_ratio:x.pressure_ratio,
      kashira_pressure_std_pa:x.kashira_pressure_std_pa,
      total_flow_rms_m3_s:x.total_flow_rms_m3_s,
      all_pipes_oscillating:x.all_pipes_oscillating,
      pipe_metrics:x.pipe_metrics
    };
  });
}

function wavBuffer(samples){
  let peak=0;
  for(const x of samples)peak=Math.max(peak,Math.abs(x));
  const gain=peak>0?0.90/peak:1;
  const dataBytes=samples.length*2;
  const b=Buffer.alloc(44+dataBytes);
  b.write('RIFF',0);b.writeUInt32LE(36+dataBytes,4);b.write('WAVE',8);
  b.write('fmt ',12);b.writeUInt32LE(16,16);b.writeUInt16LE(1,20);b.writeUInt16LE(1,22);
  b.writeUInt32LE(sampleRate,24);b.writeUInt32LE(sampleRate*2,28);b.writeUInt16LE(2,32);b.writeUInt16LE(16,34);
  b.write('data',36);b.writeUInt32LE(dataBytes,40);
  for(let i=0;i<samples.length;i++){
    const v=Math.max(-1,Math.min(1,samples[i]*gain));
    b.writeInt16LE(Math.round(v*32767),44+i*2);
  }
  return {buffer:b,peak,gain};
}

function renderSharedAudio({name,names,targetKashiraPa,direction}){
  const calibrated=runAtKashiraTarget({
    names,targetKashiraPa,direction,volumeMl:400,recoveryMs:0.5,
    flowScope:'all_pipes',duration:2.5
  });
  const mouthTarget=calibrated.required_mouth_pressure_pa;
  const activeSet=new Set(names);
  const pipes=NOTE_DEFS.map(n=>new ShoPipeModel(n));
  for(const p of pipes)p.gateTarget=activeSet.has(p.note.name)?1:0;
  const total=Math.floor(sampleRate*6);
  let mouthPressure=0,kashiraPressure=0;
  const pressureTau=0.060;
  const pressureCoeff=1-Math.exp(-dt/pressureTau);
  const compliance=400e-6/(rho*c*c);
  const recoveryTau=0.0005;
  const samples=new Float64Array(total);
  const kTail=[],mTail=[];
  for(let i=0;i<total;i++){
    mouthPressure+=(direction*mouthTarget-mouthPressure)*pressureCoeff;
    let sumFlow=0,sumAudio=0;
    for(const pipe of pipes){
      pipe.renderOne(kashiraPressure,baseParams);
      sumFlow+=pipe.lastNetInputFlowRaw;
      if(activeSet.has(pipe.note.name))sumAudio+=pipe.lastRadiation*0.00062;
    }
    const qMouth=(mouthPressure-kashiraPressure)*compliance/recoveryTau;
    kashiraPressure+=((qMouth-sumFlow)/compliance)*dt;
    if(!Number.isFinite(kashiraPressure))throw new Error('non-finite kashira in audio render '+name);
    samples[i]=sumAudio;
    if(i>total*0.6){kTail.push(kashiraPressure);mTail.push(mouthPressure);}
  }
  const wav=wavBuffer(samples);
  fs.writeFileSync(path.join(w3OutDir,name+'.wav'),wav.buffer);
  const meanAbs=a=>a.reduce((s,x)=>s+Math.abs(x),0)/Math.max(1,a.length);
  return {
    name,names,direction:direction>0?'blow':'draw',target_kashira_pa:targetKashiraPa,
    required_mouth_pressure_pa:mouthTarget,
    rendered_mean_abs_kashira_pa:meanAbs(kTail),
    rendered_mean_abs_mouth_pa:meanAbs(mTail),
    raw_peak:wav.peak,normalization_gain:wav.gain,duration_s:6
  };
}

function runAudioStudy(){
  const rows=[
    renderSharedAudio({name:'single-blow-k370',names:['一'],targetKashiraPa:370,direction:1}),
    renderSharedAudio({name:'single-draw-k90',names:['一'],targetKashiraPa:90,direction:-1}),
    renderSharedAudio({name:'chord-blow-k600',names:CHORD,targetKashiraPa:600,direction:1}),
    renderSharedAudio({name:'chord-draw-k600',names:CHORD,targetKashiraPa:600,direction:-1})
  ];
  fs.writeFileSync(path.join(w3OutDir,'audio-metadata.json'),JSON.stringify(rows,null,2)+'\n');
  return rows;
}

if(w3Study){
  if(w3Study==='ringdown')w3Write(w3Study,runRingdownStudy());
  else if(w3Study==='transfer-curve')w3Write(w3Study,runTransferCurve());
  else if(w3Study==='random-chords')w3Write(w3Study,runRandomChordStudy());
  else if(w3Study==='mouth-attack')w3Write(w3Study,runMouthAttackProbe());
  else if(w3Study==='audio-render')w3Write(w3Study,runAudioStudy());
  else throw new Error('unknown --wave3-study='+w3Study);
}
