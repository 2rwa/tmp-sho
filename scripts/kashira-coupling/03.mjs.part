measurement_doi:'10.1121/1.4778049',
    statement:'Measured kashira pressure contains higher-frequency oscillation than reed motion; cavity shape and volume may significantly affect sound.'
  },
  search_grid:{flow_scope:flowScopes,volume_ml:volumes,recovery_ms:recoveries},
  pressure_target_validation:pressureTargetValidation,
  active_chord:CHORD,
  direct_reference:directReference,
  ranked:compact
};

fs.writeFileSync(path.join(outDir,'summary.json'), JSON.stringify(summary,null,2)+'\n');
fs.writeFileSync(path.join(outDir,'full.json'), JSON.stringify({...summary, variants:ranked},null,2)+'\n');

const fields = ['flow_scope','volume_ml','recovery_ms','finite','threshold_shape_preserved','chord_all_oscillating','chord_blow_pressure_ratio','chord_draw_pressure_ratio','chord_blow_std_pa','chord_draw_std_pa','score'];
const csv = [fields.join(',')].concat(compact.map(r => fields.map(k => r[k]).join(','))).join('\n')+'\n';
fs.writeFileSync(path.join(outDir,'summary.csv'),csv);

const rows = compact.map(r => `<tr><td>${r.flow_scope}</td><td>${r.volume_ml}</td><td>${r.recovery_ms}</td><td>${r.finite}</td><td>${r.threshold_shape_preserved}</td><td>${r.chord_all_oscillating}</td><td>${r.chord_blow_pressure_ratio.toFixed(4)}</td><td>${r.chord_draw_pressure_ratio.toFixed(4)}</td><td>${r.chord_blow_std_pa.toFixed(3)}</td><td>${r.chord_draw_std_pa.toFixed(3)}</td><td>${r.score.toFixed(2)}</td></tr>`).join('');
fs.writeFileSync(path.join(outDir,'index.html'), `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Shō shared kashira sweep</title><style>body{font-family:system-ui,sans-serif;max-width:1000px;margin:2rem auto;padding:0 1rem}table{border-collapse:collapse;width:100%}th,td{border-bottom:1px solid #ddd;padding:.4rem;text-align:right}th:first-child,td:first-child{text-align:left}</style></head><body><h1>Shō shared kashira sweep</h1><p>Lumped compliance + mouth recovery resistance. Lower pressure ratio means stronger shared-pressure loading.</p><table><thead><tr><th>flow scope</th><th>V mL</th><th>τ ms</th><th>finite</th><th>thresholds</th><th>6 pipes</th><th>blow pK/pM</th><th>draw pK/pM</th><th>blow σp</th><th>draw σp</th><th>score</th></tr></thead><tbody>${rows}</tbody></table></body></html>`);

process.stdout.write(JSON.stringify({
  direct_reference:{
    single_blow_370:directReference.single_blow_370.pipe_metrics['一'],
    single_draw_90:directReference.single_draw_90.pipe_metrics['一'],
    chord_blow_all:directReference.chord_blow_600.all_pipes_oscillating,
    chord_draw_all:directReference.chord_draw_600.all_pipes_oscillating
  },
  pressure_target_validation:pressureTargetValidation.map(x => ({
    volume_ml:x.volume_ml,
    recovery_ms:x.recovery_ms,
    threshold_shape_preserved:x.threshold_shape_preserved,
    chord_all_oscillating:x.chord_all_oscillating,
    required_mouth_pressure_pa:x.required_mouth_pressure_pa,
    target_error_pa:x.target_error_pa
  })),
  top5:compact.slice(0,5)
},null,2)+'\n');
