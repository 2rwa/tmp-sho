l;
  return {
    names,
    pressure_pa: pressure,
    direction: direction > 0 ? 'blow' : 'draw',
    shared,
    volume_ml: shared ? volumeMl : null,
    recovery_ms: shared ? recoveryMs : null,
    finite,
    peak_kashira_pa: peakK,
    mean_abs_kashira_pa: meanAbsK,
    mean_abs_mouth_pa: meanAbsMouth,
    pressure_ratio: meanAbsK && meanAbsMouth ? meanAbsK / meanAbsMouth : null,
    kashira_pressure_std_pa: std(kSeries),
    total_flow_rms_m3_s: rms(flowSeries),
    pipe_metrics: pipeMetrics,
    all_pipes_oscillating: Object.values(pipeMetrics).every(x => x.oscillating)
  };
}

const directReference = {
  single_blow_370: runCase({names:['一'],pressure:370,direction:1,shared:false}),
  single_draw_90: runCase({names:['一'],pressure:90,direction:-1,shared:false}),
  chord_blow_600: runCase({names:CHORD,pressure:600,direction:1,shared:false}),
  chord_draw_600: runCase({names:CHORD,pressure:600,direction:-1,shared:false})
};

const volumes = [40, 70, 100, 150, 250];
const recoveries = [1, 2.5, 5, 10, 20];
const results = [];

for (const volumeMl of volumes) {
  for (const recoveryMs of recoveries) {
    process.stderr.write(`kashira V=${volumeMl}mL tau=${recoveryMs}ms\n`);
    const cases = {
      single_blow_360: runCase({names:['一'],pressure:360,direction:1,shared:true,volumeMl,recoveryMs}),
      single_blow_370: runCase({names:['一'],pressure:370,direction:1,shared:true,volumeMl,recoveryMs}),
      single_draw_80: runCase({names:['一'],pressure:80,direction:-1,shared:true,volumeMl,recoveryMs}),
      single_draw_90: runCase({names:['一'],pressure:90,direction:-1,shared:true,volumeMl,recoveryMs}),
      chord_blow_600: runCase({names:CHORD,pressure:600,direction:1,shared:true,volumeMl,recoveryMs}),
      chord_draw_600: runCase({names:CHORD,pressure:600,direction:-1,shared:true,volumeMl,recoveryMs})
    };

    const finite = Object.values(cases).every(x => x.finite);
    const thresholdShape =
      !cases.single_blow_360.pipe_metrics['一'].oscillating &&
      cases.single_blow_370.pipe_metrics['一'].oscillating &&
      !cases.single_draw_80.pipe_metrics['一'].oscillating &&
      cases.single_draw_90.pipe_metrics['一'].oscillating;
    const chordStable = cases.chord_blow_600.all_pipes_oscillating && cases.chord_draw_600.all_pipes_oscillating;
    const blowRatio = cases.chord_blow_600.pressure_ratio ?? 0;
    const drawRatio = cases.chord_draw_600.pressure_ratio ?? 0;
    results.push({
      volume_ml: volumeMl,
      recovery_ms: recoveryMs,
      finite,
      threshold_shape_preserved: thresholdShape,
      chord_all_oscillating: chordStable,
      chord_blow_pressure_ratio: blowRatio,
      chord_draw_pressure_ratio: drawRatio,
      chord_blow_std_pa: cases.chord_blow_600.kashira_pressure_std_pa,
      chord_draw_std_pa: cases.chord_draw_600.kashira_pressure_std_pa,
      cases
    });
  }
}

function score(x) {
  if (!x.finite) return 1e9;
  let s = 0;
  if (!x.threshold_shape_preserved) s += 1000;
  if (!x.chord_all_oscillating) s += 500;
  for (const ratio of [x.chord_blow_pressure_ratio, x.chord_draw_pressure_ratio]) {
    const droop = 1 - Math.min(1.5, Math.max(0, ratio));
    const targetDroop = 0.10;
    s += Math.abs(droop - targetDroop) * 100;
  }
  return s;
}

const ranked = [...results].sort((a,b) => score(a) - score(b));
const outArg = process.argv.find(x => x.startsWith('--out='));
const outDir = path.resolve(outArg ? outArg.slice(6) : 'results-kashira');
fs.mkdirSync(outDir, {recursive:true});

const compact = ranked.map(r => ({
  volume_ml:r.volume_ml,
  recovery_ms:r.recovery_ms,
  finite:r.finite,
  threshold_shape_preserved:r.threshold_shape_preserved,
  chord_all_oscillating:r.chord_all_oscillating,
  chord_blow_pressure_ratio:r.chord_blow_pressure_ratio,
  chord_draw_pressure_ratio:r.chord_draw_pressure_ratio,
  chord_blow_std_pa:r.chord_blow_std_pa,
  chord_draw_std_pa:r.chord_draw_std_pa,
  score:score(r)
}));

const summary = {
  schema:'sho-kashira-coupling-sweep-v1',
  run_id:process.env.GITHUB_RUN_ID || null,
  compute_repo_commit:process.env.GITHUB_SHA || null,
  source_commit:SOURCE_COMMIT,
  generated_at:new Date().toISOString(),
  model:{
    compliance:'Ca = V / (rho c^2)',
    pressure_state:'dp_kashira/dt = (Q_mouth - sum(U_i)) / Ca',
    mouth_supply:'Q_mouth = (p_mouth - p_kashira) * Ca / tau_recovery',
    note:'This is a lumped shared-pressure model only; it does not claim to reproduce high-frequency cavity modes.'
  },
  literature_context:{
    