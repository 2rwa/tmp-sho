const CHORD = ['一','凢','乙','行','七','千'];
const baseParams = {
  reedQ: 12,
  massRate: 0.30,
  drawEscapeScale: 2.25,
  drawContractionRatio: 1.50,
  reflection: 0.985,
  pipeScale: 1.0,
  reedCents: 0,
  transitionMs: 30,
  master: 0.28
};

class ShoPipeModel {
  constructor(note) {
    this.note = note;
    this.reedWidth = 0.002;
    this.reedLength = 0.010;
    this.reedThickness = 0.0003;
    this.reedDensity = 8000.0;
    this.clearance = 0.00001;
    this.flowContraction = 0.61;
    this.pipeRadius = 0.0035;
    this.characteristicImpedance = rho * c / (Math.PI * this.pipeRadius * this.pipeRadius);
    this.referencePitch = 483.75;
    this.referencePipeLength = 0.241;
    this.tipDisplacement = 0;
    this.tipVelocity = 0;
    this.returnState = 0;
    this.previousWave = 0;
    this.dcBlockState = 0;
    this.gate = 0;
    this.gateTarget = 1;
    this.delayBuffer = new Float64Array(512);
    this.writeIndex = 0;
    this.lastNetInputFlow = 0;
    this.lastRadiation = 0;
  }

  renderOne(sourcePressure, params) {
    const transitionSeconds = Math.max(0.015, params.transitionMs * 0.001);
    const gateCoefficient = 1.0 - Math.exp(-dt / transitionSeconds);
    this.gate += (this.gateTarget - this.gate) * gateCoefficient;

    const reedFrequency = this.note.freq * this.note.reedRatio;
    const reedOmega = 2 * Math.PI * reedFrequency;
    const baseMass = this.reedDensity * this.reedWidth * this.reedLength * this.reedThickness * (1 + params.massRate);
    const effectiveMass = baseMass * Math.pow(470.0 / reedFrequency, 2);

    const pipeLength = this.referencePipeLength * (this.referencePitch / this.note.freq) * params.pipeScale;
    const delaySamples = Math.max(2, 2 * pipeLength / c * sampleRate);
    let readPosition = this.writeIndex - delaySamples;
    while (readPosition < 0) readPosition += this.delayBuffer.length;
    const i0 = Math.floor(readPosition) % this.delayBuffer.length;
    const frac = readPosition - Math.floor(readPosition);
    const i1 = (i0 + 1) % this.delayBuffer.length;
    const delayedWave = this.delayBuffer[i0] * (1 - frac) + this.delayBuffer[i1] * frac;

    const effectiveReflection = 0.025 + this.gate * (params.reflection - 0.025);
    const reflectedTarget = -effectiveReflection * delayedWave;
    this.returnState += 0.62 * (reflectedTarget - this.returnState);
    const returnedPressure = this.returnState;

    const escapeScale = this.tipDisplacement < 0 ? params.drawEscapeScale : 1;
    const apertureDisplacement = this.tipDisplacement * escapeScale;
    const sideAverage = 0.4 * Math.abs(apertureDisplacement);
    const openingArea = this.reedWidth * Math.sqrt(apertureDisplacement * apertureDisplacement + this.clearance * this.clearance)
      + 2 * this.reedLength * Math.sqrt(sideAverage * sideAverage + this.clearance * this.clearance);
    const pumpedFlow = 0.4 * this.reedWidth * this.reedLength * this.tipVelocity;

    let pipeEntrancePressure = returnedPressure;
    let flowVelocity = 0;
    for (let iteration = 0; iteration < 4; iteration++) {
      const pressureDifference = sourcePressure - pipeEntrancePressure;
      const absolutePressure = Math.max(Math.abs(pressureDifference), 1e-5);
      const pressureSign = pressureDifference >= 0 ? 1 : -1;
      const contraction = this.flowContraction * (pressureSign < 0 ? params.drawContractionRatio : 1);
      const flowFactor = contraction * openingArea * Math.sqrt(2 / rho);
      flowVelocity = flowFactor * pressureSign * Math.sqrt(absolutePressure);
