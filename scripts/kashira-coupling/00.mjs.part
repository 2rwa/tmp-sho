  {name:'七',freq:967.5,reedRatio:0.975},
  {name:'比',freq:1020.4101563,reedRatio:0.970},
  {name:'言',freq:1088.4375,reedRatio:0.970},
  {name:'上',freq:1147.9614258,reedRatio:0.965},
  {name:'八',freq:1290.0,reedRatio:0.965},
  {name:'千',freq:1451.25,reedRatio:0.960}
