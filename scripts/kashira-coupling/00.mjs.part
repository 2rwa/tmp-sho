#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';

const sampleRate = 48000;
const dt = 1 / sampleRate;
const SOURCE_COMMIT = '6c1fcfcdc2214dfcc98740ce798f7733708ee4bd';
const rho = 1.2;
const c = 340.0;

